node_modules/
dist/
*.log
dist-lib/
skill-dist/
coverage/
.claude/

# Written only when the visual gate finds a chart nobody could see.
visible-charts/

# playwright-cli's scratch output (snapshots, screenshots). The configs beside
# it in .playwright/ are checked in on purpose.
.playwright-cli/

# Stryker copies the whole repo here while it runs.
.stryker-tmp/
reports/

# The browser session the round driver drives (see scripts/pw.sh).
.pw-session/

# The driver's account of how the LAST round ended, for whatever runs the next
# one. State, not evidence — the evidence is the archived round in rounds/.
.round-outcome.json

# Crash reports are forensic dumps from a LIVE, AUTHENTICATED session — request
# URLs, session ids, the document name. This repo is public. The README stays;
# the reports never leave the machine.
crashes/*.md
!crashes/README.md
